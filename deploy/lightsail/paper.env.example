# Simulation only; contains no credentials. Default: blocked strict-mode decisions.
PAPER_ENABLED=true
PAPER_MODE=strict
PAPER_QUANTITY=1
PAPER_CALENDAR_PATH=/app/deploy/lightsail/calendar-paper-2026.json
PAPER_ACCEPT_SCHEDULED_CALENDAR=false
PAPER_ACCEPT_START_LABELS=false
PAPER_MAX_OBSERVATION_DELAY_SECONDS=60
# Unspecified costs produce netPnl:null. If supplied, net is a configured estimate, not verified charges.
PAPER_FEES_PER_SIDE=
PAPER_SLIPPAGE_BPS=
# Explicit optional research setup requires changing all three of these together:
# PAPER_MODE=approximate-research
# PAPER_ACCEPT_SCHEDULED_CALENDAR=true
# PAPER_ACCEPT_START_LABELS=true
# Do NOT change DHAN_CANDLE_START_VERIFIED merely to enable research.

# Production Nifty 50 scanner. Invalid/expired membership fails startup.
RECORDER_UNIVERSE=nifty50
RECORDER_UNIVERSE_PATH=/app/deploy/lightsail/nifty50-2026-10-21.json

# Optional isolated research cohorts; baseline remains raw Nifty50 ORB.
PAPER_RESEARCH_ENABLED=false
RECORDER_WATCHLIST_PATH=/data/{date}.watchlists.json
RECORDER_FETCH_COMPLETED_ONLY=true
RECORDER_POLL_INTERVAL_SECONDS=15

# Legacy default when omitted is 15:15. AWS research uses 15:10 to precede the observed tail gap.
# Hypothetical open price is admitted only after the selected candle completes.
PAPER_EXIT_TIME_IST=15:15
