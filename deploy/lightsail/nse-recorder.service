[Unit]
Description=NSE read-only market session recorder
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/nse-assistant
ExecStart=/usr/bin/flock -n /run/lock/nse-recorder-cloud.lock /usr/bin/docker run --rm --init --name nse-recorder --read-only --cap-drop=ALL --security-opt=no-new-privileges --tmpfs /run/recorder:rw,noexec,nosuid,uid=1000,gid=1000,mode=0700 --env-file /etc/nse-assistant/dhan.env --env RECORDER_DATA_DIR=/data --mount type=bind,source=/var/lib/nse-recorder,target=/data nse-recorder:local
ExecStop=-/usr/bin/docker stop --time 30 nse-recorder
Restart=on-failure
RestartSec=60
SuccessExitStatus=2
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
