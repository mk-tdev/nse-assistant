# Replace with the bcrypt hash from caddy hash-password. Never commit plaintext passwords.
nse-assistant.pixeltrendanalytics.com {
 encode zstd gzip
 header {
  X-Robots-Tag "noindex, nofollow, noarchive"
  Strict-Transport-Security "max-age=31536000"
 }
 basic_auth {
  mk {$DASHBOARD_PASSWORD_HASH}
 }
 reverse_proxy 127.0.0.1:8787 {
  header_up -Authorization
 }
}
