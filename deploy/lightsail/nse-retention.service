[Unit]
Description=Preserve trading research and archive redundant finalized NSE diagnostics
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/nse-assistant/scripts/nse-retention.py --apply
User=root
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
TimeoutStartSec=45min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/nse-recorder /var/lib/nse-retention /run/lock
PrivateTmp=true
StandardOutput=journal
StandardError=journal
