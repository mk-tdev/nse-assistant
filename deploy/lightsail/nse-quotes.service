[Unit]
Description=NSE read-only Dhan quote snapshots (never executes orders)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --init --name nse-quotes --read-only --cap-drop=ALL --security-opt=no-new-privileges --env-file /etc/nse-assistant/dhan.env --env RECORDER_DATA_DIR=/data --mount type=bind,source=/var/lib/nse-recorder,target=/data nse-dashboard:local node dist/quote-recorder.js
ExecStop=-/usr/bin/docker stop --time 20 nse-quotes
Restart=always
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
