{
  "name": "dhan-market-data-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only NSE equity data MCP and conservative paper-only opening range analysis",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/stdio.js",
    "check": "npm run typecheck && npm test && npm run build",
    "test:http": "node --import tsx test/http-simulation.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "csv-parse": "7.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
